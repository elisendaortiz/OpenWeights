# Copy this file to .env and adjust the values: cp .env.example .env
# Local Ollama (OpenAI-compatible endpoint)
BASE_URL=http://localhost:11434/v1
MODEL=qwen2.5:1.5b
# Ollama ignores the key, but the client library requires a non-empty value.
# For a real provider or vLLM with auth, put the real key in .env (never commit it).
API_KEY=ollama
